{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    /* No explicit "types": ["node"]. An entry listed here that cannot be
       resolved is a hard error, which is what an editor reports whenever its
       language server starts before `npm install` has run. Left unlisted,
       @types/node is still picked up automatically when it is present and
       simply absent when it is not — and vite.config.ts uses no Node API. */
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
